<script>
  // Replaces body.tsx's react-markdown Codeblock component. Shiki (build
  // time) already renders syntax highlighting and line numbers (global.css);
  // this only adds the language label + copy button chrome, matching the
  // old runtime component's markup and behaviour.
  for (const pre of document.querySelectorAll<HTMLPreElement>("article pre.astro-code")) {
    const language = pre.dataset.language ?? "";

    const bar = document.createElement("div");
    bar.className = "flex w-full items-center justify-between px-6 py-1 pr-4 bg-secondary rounded-b-none rounded-t-xl";

    const label = document.createElement("span");
    label.className = "text-xs lowercase";
    label.textContent = language;
    bar.appendChild(label);

    const button = document.createElement("button");
    button.type = "button";
    button.className =
      "inline-flex items-center justify-center rounded-md text-xs h-9 w-9 hover:bg-accent hover:text-accent-foreground transition-colors";
    button.innerHTML = `
      <svg data-icon="copy" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
      <svg data-icon="check" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M20 6 9 17l-5-5"/></svg>
      <span class="sr-only">Copy code</span>
    `;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
      } catch {
        return;
      }
      button.querySelector('[data-icon="copy"]')?.classList.add("hidden");
      button.querySelector('[data-icon="check"]')?.classList.remove("hidden");
      setTimeout(() => {
        button.querySelector('[data-icon="copy"]')?.classList.remove("hidden");
        button.querySelector('[data-icon="check"]')?.classList.add("hidden");
      }, 2000);
    });
    bar.appendChild(button);

    pre.classList.add("rounded-t-none");
    pre.parentElement?.insertBefore(bar, pre);
  }
</script>
