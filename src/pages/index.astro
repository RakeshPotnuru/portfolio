---
import { getCollection } from "astro:content";

import Base from "@/layouts/Base.astro";
import Hero from "@/components/modules/home/Hero.astro";
import RecentProjects from "@/components/modules/home/RecentProjects.astro";
import LatestBlogPosts from "@/components/modules/home/LatestBlogPosts.astro";
import LatestSnippets from "@/components/modules/home/LatestSnippets.astro";
import WhyHireMe from "@/components/modules/home/WhyHireMe.astro";

// Each collection's loader already orders by the same field Gatsby's
// GraphQL query sorted on (launchedAt/publishedAt/createdAt DESC), so a
// slice here is enough — no re-sorting needed.
const projects = (await getCollection("projects")).slice(0, 2);
const posts = (await getCollection("posts", ({ data }) => !!data.publishedAt)).slice(0, 2);
const snippets = (await getCollection("snippets")).slice(0, 3);
---

<Base mainClass="space-y-20">
  <Hero />
  <RecentProjects projects={projects} />
  <LatestBlogPosts posts={posts} />
  <LatestSnippets snippets={snippets} />
  <WhyHireMe />
</Base>
